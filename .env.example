# Local development only. Copy this file to .env before starting Compose.
POSTGRES_DB=lajkonikgo
POSTGRES_USER=lajkonikgo
POSTGRES_PASSWORD=local_development_only

# Use Compose service names from inside the backend container.
# If you change the PostgreSQL credentials, update DATABASE_URL as well.
# URL-encode special characters in the username/password used in DATABASE_URL.
DATABASE_URL=postgresql+psycopg://lajkonikgo:local_development_only@postgres:5432/lajkonikgo
REDIS_URL=redis://redis:6379/0

# Set API_BIND_HOST=0.0.0.0 when connecting from a physical phone on your LAN.
API_BIND_HOST=127.0.0.1
API_PORT=8000

# Route geometry uses the public Valhalla instance for local development.
ROUTING_BASE_URL=https://valhalla1.openstreetmap.de
# Optional verified municipal GeoJSON of barriers (documented in backend/README.md).
CITY_ACCESSIBILITY_URL=
# Comma-separated deployed frontend origins; localhost is allowed automatically.
FRONTEND_ORIGINS=
# Reserved for future integrations, not used by municipal adapters.
ROUTING_API_KEY=
DATA_API_KEY=
